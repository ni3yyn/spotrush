; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SpotRush"
run/main_scene="res://scenes/boot/BootScreen.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0.894118, 0.913725, 0.94902, 1)
boot_splash/image="res://assets/ui/BootSplash.png"
config/icon="res://assets/ui/AppIcon.png"
boot_splash/minimum_display_time=200

[audio]

; Forces the older, far more battle-tested OpenSL ES backend on Android
; instead of Godot's default AAudio driver. The crash we're chasing -
; "Fatal signal 11 (SIGSEGV)... in tid NNNN (AudioTrack)" - is a known
; failure signature for Godot's AAudio driver on a subset of Android
; devices/OS versions (its callback thread dies natively with no GDScript
; stack trace to show for it, exactly what CrashLogger captured). AAudio is
; the newer, lower-latency path, but OpenSL ES is the long-stable fallback
; and is what this pins to. If the crash disappears on this build, that
; confirms the driver as the cause instead of our own synthesis code; if it
; still happens, that points back at Music.gd/Sfx.gd instead.
driver/driver.android="Opensl"

[autoload]

NetworkSession="*res://scripts/networking/NetworkSession.gd"
SceneRouter="*res://scripts/core/SceneRouter.gd"
GameManager="*res://scripts/core/GameManager.gd"
BackNav="*res://scripts/core/BackNav.gd"
NeuDialog="*res://scripts/ui/NeuDialog.gd"
AppLifecycle="*res://scripts/core/AppLifecycle.gd"
Music="*res://scripts/core/Music.gd"
DailyReminder="*res://scripts/core/DailyReminder.gd"
CrashLogger="*res://scripts/core/CrashLogger.gd"
OtaUpdater="*res://scripts/core/OtaUpdater.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=720
window/size/window_height_override=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/NotificationSchedulerPlugin/plugin.cfg")

[gui]

theme/custom="res://assets/ui/SpotRushTypography.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true

[logging]

file_logging/enable_file_logging=true
file_logging/log_path="user://logs/godot.log"
file_logging/max_log_files=6

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.090196, 0.137255, 0.121569, 1)
