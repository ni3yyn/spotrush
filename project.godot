; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SpotRush"
run/main_scene="res://scenes/boot/BootScreen.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0.894118, 0.913725, 0.94902, 1)
boot_splash/image="res://assets/ui/BootSplash.png"
config/icon="res://assets/ui/AppIcon.png"
boot_splash/minimum_display_time=200

[autoload]

NetworkSession="*res://scripts/networking/NetworkSession.gd"
SceneRouter="*res://scripts/core/SceneRouter.gd"
GameManager="*res://scripts/core/GameManager.gd"
BackNav="*res://scripts/core/BackNav.gd"
NeuDialog="*res://scripts/ui/NeuDialog.gd"
AppLifecycle="*res://scripts/core/AppLifecycle.gd"
Music="*res://scripts/core/Music.gd"
DailyReminder="*res://scripts/core/DailyReminder.gd"
CrashLogger="*res://scripts/core/CrashLogger.gd"
OtaUpdater="*res://scripts/core/OtaUpdater.gd"
#EOSG2.3.1runtimeservices.Theseareregisteredexplicitlysoheadless#exportsdonotdependonaneditor-pluginenablecallbackhavingrunfirst.EOSGRuntime="*res://addons/epic-online-services-godot/runtime.gd"
HPlatform="*res://addons/epic-online-services-godot/heos/hplatform.gd"
HAuth="*res://addons/epic-online-services-godot/heos/hauth.gd"
HAchievements="*res://addons/epic-online-services-godot/heos/hachievements.gd"
HFriends="*res://addons/epic-online-services-godot/heos/hfriends.gd"
HStats="*res://addons/epic-online-services-godot/heos/hstats.gd"
HLeaderboards="*res://addons/epic-online-services-godot/heos/hleaderboards.gd"
HLobbies="*res://addons/epic-online-services-godot/heos/hlobbies.gd"
HP2P="*res://addons/epic-online-services-godot/heos/hp2p.gd"
HSessions="*res://addons/epic-online-services-godot/heos/hsessions.gd"
DeepLinkRouter="*res://scripts/networking/DeepLinkRouter.gd"
EOSOnline="*res://scripts/networking/EOSOnline.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=720
window/size/window_height_override=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/NotificationSchedulerPlugin/plugin.cfg", "res://addons/epic-online-services-godot/plugin.cfg")

[gui]

theme/custom="res://assets/ui/SpotRushTypography.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true

[logging]

file_logging/enable_file_logging=true
file_logging/log_path="user://logs/godot.log"
file_logging/max_log_files=6
file_logging/flush_after_each_print=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.090196, 0.137255, 0.121569, 1)
